# Copie para ".env" e ajuste. O ".env" não vai para o GitHub (está no .gitignore).

# Senha de acesso ao painel (usuário + senha pelo login do navegador).
# Deixe vazio para acesso livre, o que só é recomendado em uso local.
SENHA_ACESSO=
USUARIO_ACESSO=admin

# Porta do servidor. Hospedagens costumam definir PORT ou SERVER_PORT sozinhas.
PORT=3000
